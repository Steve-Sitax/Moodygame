{
  "version": 1,
  "items": {
    "herring": {
      "name": "a salt herring",
      "food": 2,
      "use": "eat"
    },
    "eel": {
      "name": "a smoked eel",
      "food": 4,
      "use": "eat"
    },
    "biscuit": {
      "name": "ship's biscuit",
      "food": 2,
      "use": "eat"
    },
    "jenever": {
      "name": "a nip of jenever",
      "warmth": 2,
      "health": -1,
      "use": "drink",
      "note": "Warms you now. The pastoor will smell it."
    },
    "bread": {
      "name": "a loaf of rye bread",
      "food": 3,
      "use": "eat"
    },
    "apple": {
      "name": "an apple",
      "food": 1,
      "use": "eat"
    },
    "beer": {
      "name": "a pot of brown beer",
      "food": 1,
      "warmth": 1,
      "use": "drink"
    },
    "parcel": {
      "name": "a parcel",
      "note": "Tied with tarred string. Don't open it."
    },
    "lantern": {
      "name": "a hand lantern",
      "note": "Tin and horn, a tallow candle inside. L to hold it up."
    },
    "soup": {
      "name": "a bowl of pea soup",
      "food": 3,
      "warmth": 2,
      "use": "eat",
      "atCounter": true
    },
    "newspaper": {
      "name": "the morning Handelsblad",
      "use": "read",
      "note": "Four pages of small print, still smelling of ink."
    },
    "letter": {
      "name": "a letter",
      "use": "read",
      "note": "Folded and sealed with a blob of wax."
    },
    "letters": {
      "name": "a bundle of letters",
      "note": "Tied with string. Each goes to its own door."
    },
    "pawn_ticket": {
      "name": "a pawn ticket",
      "use": "read",
      "note": "Printed card from the Berg van Barmhartigheid. Keep it safe."
    },
    "pocket_watch": {
      "name": "a silver pocket watch",
      "note": "Not yours. Somebody's initials on the lid."
    },
    "handkerchief": {
      "name": "a linen handkerchief",
      "note": "Good linen, a stranger's initials stitched in the corner."
    },
    "medal": {
      "name": "your mother's silver medal",
      "note": "Our Lady, on a worn blue ribbon. She pressed it into your hand the day you left."
    },
    "velocipede_new": {
      "name": "a new velocipede",
      "note": "Iron backbone, oak wheels with iron tyres, a leather saddle. Yours."
    },
    "velocipede_used": {
      "name": "a second-hand velocipede",
      "note": "Scratched paint, a patched saddle, and it goes as well as any. Yours."
    },
    "velocipede_hire": {
      "name": "a velocipede for the day",
      "note": "Back at his door before the day is out, or his boy fetches it."
    },
    "milk": {
      "name": "a mug of fresh milk",
      "food": 1,
      "use": "drink"
    },
    "roll": {
      "name": "a white roll",
      "food": 1,
      "use": "eat"
    },
    "mussels": {
      "name": "a cone of boiled mussels",
      "food": 2,
      "warmth": 1,
      "use": "eat"
    },
    "broom": {
      "name": "a birch broom",
      "note": "Birch twigs bound to a hazel stick. Every house in the lane has one like it."
    },
    "scarf": {
      "name": "an old woollen scarf",
      "note": "Darned in three colours, but it keeps the wind off your neck."
    },
    "knife": {
      "name": "a clasp knife",
      "note": "Horn handle, a blade he ground on his wheel while you waited."
    },
    "coal": {
      "name": "a small bag of coal",
      "note": "Heavy for its size, and black on everything it touches."
    },
    "candle": {
      "name": "a votive candle",
      "note": "Tallow, with a paper collar printed with Our Lady."
    },
    "rosary": {
      "name": "a rosary of wooden beads",
      "note": "Boxwood beads on a cord, a tin cross."
    },
    "holy_picture": {
      "name": "a holy picture",
      "note": "A small print of Our Lady of Antwerp, coloured by hand."
    },
    "peperkoek": {
      "name": "a slice of peperkoek",
      "food": 1,
      "use": "eat",
      "note": "Honey cake with anise, dark and sticky."
    },
    "sausage": {
      "name": "a smoked sausage",
      "food": 3,
      "use": "eat"
    },
    "bacon": {
      "name": "a piece of fat bacon",
      "food": 4,
      "warmth": 1,
      "use": "eat"
    },
    "brawn": {
      "name": "a slice of brawn",
      "food": 2,
      "use": "eat",
      "note": "Head cheese in its jelly, wrapped in a cabbage leaf."
    },
    "cheese": {
      "name": "a wedge of cheese",
      "food": 2,
      "use": "eat"
    },
    "candy": {
      "name": "a twist of sugar candy",
      "food": 1,
      "use": "eat"
    },
    "figs": {
      "name": "a bag of dried figs",
      "food": 2,
      "use": "eat"
    },
    "chocolate": {
      "name": "a bar of chocolate",
      "food": 2,
      "warmth": 1,
      "use": "eat"
    },
    "tea": {
      "name": "a packet of tea",
      "note": "A quarter pound of black tea in a paper with a Chinese stamp. A present, or to sell."
    },
    "pipe": {
      "name": "a clay pipe with shag",
      "warmth": 1,
      "use": "smoke",
      "note": "A short white clay pipe, filled. Lit with a lucifer from the box on the counter."
    },
    "cigar": {
      "name": "a cigar",
      "warmth": 1,
      "use": "smoke",
      "note": "A cheap Dutch cigar in a paper band."
    },
    "matches": {
      "name": "a box of lucifers",
      "note": "Sulphur matches in a card box. They strike on anything."
    },
    "syrup": {
      "name": "a bottle of cough syrup",
      "health": 1,
      "use": "drink",
      "note": "Brown, sweet and bitter, with a label in Latin."
    },
    "powder": {
      "name": "a fever powder",
      "health": 2,
      "use": "eat",
      "note": "Quinine and chalk folded in a paper. Swallowed with water."
    },
    "liquorice": {
      "name": "a stick of liquorice",
      "food": 1,
      "use": "eat"
    },
    "wool_vest": {
      "name": "a knitted wool vest",
      "warmth": 3,
      "use": "wear",
      "note": "Grey wool, thick as a blanket. It goes under your coat."
    },
    "shawl": {
      "name": "a woollen neckerchief",
      "warmth": 2,
      "use": "wear"
    },
    "flat_cap": {
      "name": "a cloth flat cap",
      "warmth": 1,
      "use": "wear",
      "note": "Tweed, lined. It keeps the drizzle off your head."
    },
    "felt_hat": {
      "name": "a second-hand felt hat",
      "warmth": 1,
      "use": "wear",
      "note": "A brown bowler with a worn band. You look almost like a clerk in it."
    },
    "boot_mend": {
      "name": "your boots mended",
      "warmth": 1,
      "atCounter": true
    },
    "laces": {
      "name": "a pair of leather laces",
      "note": "Tanned thongs, long enough for any boot."
    },
    "shave": {
      "name": "a shave",
      "atCounter": true
    },
    "haircut": {
      "name": "a haircut",
      "atCounter": true
    },
    "coffee": {
      "name": "a cup of coffee",
      "warmth": 2,
      "use": "drink"
    },
    "coffee_beans": {
      "name": "a bag of roasted coffee",
      "note": "Half a pound, still warm from the drum. A present fit for anyone."
    },
    "almanac": {
      "name": "a printed almanac",
      "note": "This year's Antwerp almanac: saints' days, tides, the fairs and a few jokes."
    },
    "paper_env": {
      "name": "a sheet of paper and an envelope",
      "note": "Good paper, for a letter of your own."
    },
    "penny_book": {
      "name": "a cheap novel",
      "note": "Thirty pages of murder and a lost heiress, printed in Brussels."
    },
    "prayer_book": {
      "name": "a second-hand prayer book",
      "note": "Leather worn to the board at the corners, somebody's name inside the cover."
    },
    "watch": {
      "name": "a second-hand pocket watch",
      "note": "Nickel case, a white dial, it keeps time if you wind it. The Berg lends on it."
    },
    "watch_key": {
      "name": "a watch key",
      "note": "A small brass key on a ring."
    },
    "chair": {
      "name": "a rush-seated chair",
      "note": "Rush seat, one leg mended.",
      "carry": "arms"
    },
    "table": {
      "name": "a deal table",
      "note": "Scrubbed pine, rings from other men's pots.",
      "carry": "arms"
    },
    "rug": {
      "name": "a rag rug",
      "note": "Woven from old coats. Keeps the cold off the floor.",
      "carry": "arms"
    },
    "stove": {
      "name": "a cast-iron stove",
      "note": "A little pot-bellied stove, pipe included. Heavy.",
      "carry": "arms"
    },
    "plant": {
      "name": "a geranium in a pot",
      "note": "Red, a bit leggy. Wants the light.",
      "carry": "arms"
    },
    "birdcage": {
      "name": "a finch in a cage",
      "note": "A chaffinch in a wicker cage on a stand. It sings at dawn.",
      "carry": "arms"
    },
    "picture": {
      "name": "a framed print",
      "note": "The cathedral spire in a black frame. Hang it on a wall."
    },
    "lamp": {
      "name": "a hanging oil lamp",
      "note": "Brass font, glass chimney. Hang it from a beam."
    },
    "clock": {
      "name": "a wall clock",
      "note": "A Black Forest clock. It ticks; the hour is the town's."
    },
    "curtains": {
      "name": "a pair of curtains",
      "note": "Faded red wool. For a window."
    },
    "handcart_new": {
      "name": "a new handcart",
      "note": "Ash shafts, elm wheels with iron tyres, a plank bed with rails. Yours."
    },
    "handcart_used": {
      "name": "a second-hand handcart",
      "note": "The paint is gone and one rail is new wood, but the wheels run true. Yours."
    },
    "handcart_hire": {
      "name": "a handcart for the day",
      "note": "Back at his door before the day is out, or his boy fetches it."
    },
    "ballad": {
      "name": "a ballad sheet",
      "use": "read",
      "note": "Coarse grey paper, a smudged woodcut at the top, the words in cramped type."
    }
  },

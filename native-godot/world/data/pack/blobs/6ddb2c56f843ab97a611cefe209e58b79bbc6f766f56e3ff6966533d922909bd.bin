  ],
  "blink": "blink",
  "hands": "hands_hard",
  "note": "morph targets of each <body>_lod0 and <kind>_lod0, positions only: face shapes mixed per person by seed (head.face_mix; a kind has its own mix baked in and the keys add to it), blink 0..1, hands_hard 1 on dockers"
 },
 "lod": {
  "lod1From": 15.0,
  "note": "LOD1 also for the mirrors and the lantern shadow"
 },
 "heightFactor": {
  "min": 0.96,
  "max": 1.04,
  "sd": 0.02,
  "note": "per person, from the person's seed (a normal draw, sd 0.02, clamped to min..max): scale the person's top node uniformly by f. Locomotion: every clip's stride, speed and travel times f (the speed blend works on stride*f; the foot lock takes out the rest); sockets, marks, grips and the hips tracks follow the node. (docs/people.md 'Builds')"
 },
 "oldStance": {
  "clips": {
   "idle": "idle_old",
   "idle_f": "idle_f_old",
   "talk": "talk_old",
   "talk_f": "talk_f_old"
  },
  "thighFwdDeg": 5.0,
  "kneeDeg": 10.0,
  "footDeg": -5.0,
  "hipsDrop": 0.003,
  "note": "bodies with stoopDeg > 0: play <clip>_old where it exists; for any other standing clip add per leg legUp RX(-thighFwdDeg), legLow RX(kneeDeg), foot RX(footDeg) (pose convention, before the clip's own turn) and lower the hips by hipsDrop m (docs/people.md 'The old')"
 },
 "locomotion": {
  "about": "package D1 clips (art-source/tools/blender/people2/clips_move.py, docs/people.md 'Locomotion'). Loops are two strides, in place: move the node at their speed. Clips that travel move the hips: move the node by their travel at the end. Hips translation tracks are the clip's own body's offset from its rest, added to man_middling's hips rest (trackBase).",
  "trackBase": [
   0.0,
   0.9118,
   0.0
  ],
  "blend": {
   "families": {
    "walks": [
     "stroll",
     "walk",
     "hurry"
    ],
    "runs": [
     "run",
     "sprint"
    ]
   },
   "weight": "neighbours by speed a < v < b: w = (Sa - v Ta) / (v (Tb - Ta) - (Sb - Sa)), S = stride, T = cycle (clip meta); mix rotations by slerp(w) and hips translations by lerp(w)",
   "phase": "one shared phase for all loops (each is two strides, left heel at 0 and 0.5), advanced by dt / (2 T), T = lerp(Ta, Tb, w)",
   "ends": "below the slowest or above the fastest loop of a family play its end loop at cycle = stride / v",
   "switch": "walk to run (and back) as v passes 2.2 m/s: crossfade inside a window where both gaits agree (clips_move.switch_windows: one foot down in both, the other in the air in both), never held as a mix",
   "feet": "lock the planted feet with leg IK every frame (motion.lock_feet does it here): blends move the pose, not the feet; measured with the lock: under 2 mm",
   "otherBodies": "a clip made on one body plays on another of the same base unchanged; on a smaller or bigger body scale its speed and stride by the ratio of the hips heights (peopleRig bodies.<b>.hipsBone)"
  },
  "stairs": {
   "rise": 0.17,
   "going": 0.28
  },
  "slopeDeg": 8.0,

config_version=5

[application]
config/name="Scheldemist Town Workshop"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="ScheldemistWorkshop"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/min_width=1200
window/size/min_height=840
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="Scheldemist.Native"

[physics]
3d/physics_engine="Jolt Physics"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

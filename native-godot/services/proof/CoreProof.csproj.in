<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.30" />
    <Compile Include="../../native-godot/src/Services/NativeCore*.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../../native-godot/src/Services/NativeService*.cs" Link="Services/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <!-- The native editor runs this shared animation runtime too. Keep its hot sampler optimized. -->
    <Optimize>true</Optimize>
    <RootNamespace>Scheldemist</RootNamespace>
  </PropertyGroup>
  <!-- Offline intake changes invalidate their generated resources by content. They
       cannot change startup geometry until those resources are converted again. -->
  <ItemGroup><StartupGeometrySource Include="src/World/**/*.cs;src/Models/**/*.cs;src/Render/**/*.cs;src/Paths.cs" Exclude="src/World/StartupCachePrune.cs;src/World/StartupResources.cs;src/World/Ruien/RuienGeometryCache.cs;src/World/Ruien/RuienFoldBridge.Cache.cs;src/World/Ruien/RuienArea.Streaming.cs;src/World/Ruien/RuienCover.Cache.cs;src/World/Ruien/RuienProof*.cs;src/World/Ruien/RuienFrameProfile.cs;src/World/Ruien/RuienImport.cs;src/World/Ruien/RuienGlb.cs;src/World/Ruien/RuienRepair.cs;src/World/Ruien/RuienRepairFix.cs;src/World/Ruien/RuienDepositRepair.cs" /></ItemGroup>
  <Import Project="../tools/build/StartupGeometry.targets" />
</Project>

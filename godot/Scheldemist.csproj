<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <!-- The native editor runs this shared animation runtime too. Keep its hot sampler optimized. -->
    <Optimize>true</Optimize>
    <RootNamespace>Scheldemist</RootNamespace>
  </PropertyGroup>
  <ItemGroup><StartupGeometrySource Include="src/World/**/*.cs;src/Models/**/*.cs;src/Render/**/*.cs;src/Main.cs;src/Paths.cs" /></ItemGroup>
  <Import Project="../tools/build/StartupGeometry.targets" />
</Project>
